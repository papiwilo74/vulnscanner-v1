# OmniBreach Enterprise — AI Copilot Configuration
# Motor Híbrido: Groq Cloud (Inferencia ultrarrápida LPU) + Ollama (Local privado RTX 4060)

# 1. Groq Cloud API (Obtén tu clave gratuita en https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen-2.5-32b

# 2. Ollama Local (Fallback privado en tu GPU RTX 4060)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 3. Preferencia: false = usar Groq primero y Ollama de respaldo; true = usar Ollama primero
COPILOT_PREFER_LOCAL=false
